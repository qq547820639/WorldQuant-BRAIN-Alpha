# import-linter configuration for BRAIN Alpha Ops (v4.0 M5)
# Run: import-linter lint
# Install: pip install import-linter

root_package: brain_alpha_ops

contracts:
  # Shared kernel: no upward dependencies
  - name: shared_has_no_domain_deps
    type: forbidden
    source: shared
    forbidden:
      - research
      - web
      - agents
    message: "shared/ must not import from research, web, or agents"

  # BRAIN API: anti-corruption layer isolation
  - name: brain_api_isolation
    type: forbidden
    source: brain_api
    forbidden:
      - research
      - web
      - agents
    message: "brain_api/ must not import from research, web, or agents"

  # Data layer: no domain logic imports
  - name: data_layer_isolation
    type: forbidden
    source: data
    forbidden:
      - research
      - web
      - agents
    message: "data/ should not import from research, web, or agents"

  # Research: no web imports (domain shouldn't know about HTTP)
  - name: research_has_no_web_deps
    type: forbidden
    source: research
    forbidden:
      - web
      - agents
    message: "research/ must not import from web/ or agents/"

  # Config: no domain imports
  - name: config_isolation
    type: forbidden
    source: config
    forbidden:
      - research
      - web
      - agents
    message: "config/ must not import from research, web, or agents"
