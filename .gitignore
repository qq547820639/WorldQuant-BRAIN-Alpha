# ---- Archive ----
_archive_before_rebuild_*/

# ---- Temp / External source copies ----
.codex_tmp_quantgpt_src/
.pytest_tmp*/

# ---- Output artifacts ----
output/

# ---- Runtime-generated data (never commit) ----
data/*.jsonl
data/*.sqlite
data/run_history/
data/knowledge/
data/api_cache/
data/_codex_bench*/
data/checkpoints/
data/*.log
data/e2e_screenshots/

# ---- Credentials (NEVER commit) ----
.env
.env.*
credentials.json
secrets.json

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb

# ---- OS ----
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.codex_tmp_quantgpt.zip

# ---- Executables (large binaries) ----
*.exe

# ---- Test output artifacts ----
.playwright-cli/
test_results.txt
_run_new_tests.py
_coverage/
htmlcov/
.coverage
experiments/scratch/
